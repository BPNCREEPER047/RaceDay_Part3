<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} – RaceDay" : "RaceDay")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&family=Barlow+Condensed:wght@700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<!-- ── Navbar ──────────────────────────────────────────────────────────────── -->
<nav class="navbar navbar-expand-lg rd-navbar">
    <div class="container">
        <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">
            <i class="bi bi-stopwatch-fill me-2"></i>RaceDay
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-calendar-event me-1"></i>Events
                    </a>
                </li>

                @if (ViewBag.IsLoggedIn == true && ViewBag.CurrentRole == "Organiser")
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Events" asp-action="Dashboard">
                            <i class="bi bi-speedometer2 me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Categories" asp-action="Index">
                            <i class="bi bi-tags me-1"></i>Categories
                        </a>
                    </li>
                }

                @if (ViewBag.IsLoggedIn == true && ViewBag.CurrentRole == "Participant")
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Enrolments" asp-action="MyEnrolments">
                            <i class="bi bi-clipboard-check me-1"></i>My Events
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Results" asp-action="MyResults">
                            <i class="bi bi-trophy me-1"></i>My Results
                        </a>
                    </li>
                }
            </ul>

            <ul class="navbar-nav">
                @if (ViewBag.IsLoggedIn == true)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle rd-user-pill" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i>@ViewBag.CurrentName
                            <span class="rd-role-badge @(ViewBag.CurrentRole == "Organiser" ? "badge-org" : "badge-part")">
                                @ViewBag.CurrentRole
                            </span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i>Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                    <button class="dropdown-item text-danger" type="submit">
                                        <i class="bi bi-box-arrow-right me-2"></i>Log out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Auth" asp-action="Login">Log in</a>
                    </li>
                    <li class="nav-item ms-2">
                        <a class="btn rd-btn-primary btn-sm" asp-controller="Auth" asp-action="Register">Sign up</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<!-- ── Alerts ──────────────────────────────────────────────────────────────── -->
@if (TempData["Success"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}

<!-- ── Main content ────────────────────────────────────────────────────────── -->
<main>
    @RenderBody()
</main>

<!-- ── Footer ─────────────────────────────────────────────────────────────── -->
<footer class="rd-footer mt-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <span class="rd-brand"><i class="bi bi-stopwatch-fill me-1"></i>RaceDay</span>
                <span class="text-muted ms-3 small">South African road running, walking &amp; cycling</span>
            </div>
            <div class="col-md-6 text-md-end text-muted small mt-2 mt-md-0">
                &copy; @DateTime.Now.Year RaceDay — All rights reserved
            </div>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
