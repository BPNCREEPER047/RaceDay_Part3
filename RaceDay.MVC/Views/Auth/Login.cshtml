@model LoginViewModel
@{ ViewData["Title"] = "Log in"; Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log in – RaceDay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&family=Barlow+Condensed:wght@700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<div class="rd-auth-page">
    <div class="container">
        <div class="rd-auth-card">
            <div class="text-center mb-4">
                <a href="/" class="rd-brand text-decoration-none">
                    <i class="bi bi-stopwatch-fill"></i> RaceDay
                </a>
                <h2 class="mt-3 mb-1">Welcome back</h2>
                <p class="text-muted small">Log in to your account</p>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]</div>
            }

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewContext.ModelState.IsValid ? "none" : "block")"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="you@example.com" autofocus />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label fw-semibold">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn rd-btn-primary w-100 py-2 fw-bold">
                    Log in <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </form>

            <hr class="my-4" />
            <p class="text-center text-muted small mb-0">
                Don't have an account?
                <a asp-controller="Auth" asp-action="Register" class="fw-semibold text-danger">Sign up</a>
            </p>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
