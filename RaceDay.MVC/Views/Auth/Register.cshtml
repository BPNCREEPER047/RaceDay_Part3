@model RegisterViewModel
@{ ViewData["Title"] = "Sign up"; Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign up – RaceDay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&family=Barlow+Condensed:wght@700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<div class="rd-auth-page">
    <div class="container">
        <div class="rd-auth-card" style="max-width:480px;">
            <div class="text-center mb-4">
                <a href="/" class="rd-brand text-decoration-none">
                    <i class="bi bi-stopwatch-fill"></i> RaceDay
                </a>
                <h2 class="mt-3 mb-1">Create account</h2>
                <p class="text-muted small">Join thousands of South African athletes</p>
            </div>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewContext.ModelState.IsValid ? "none" : "block")"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold">Full name</label>
                    <input asp-for="FullName" class="form-control" placeholder="Jane Runner" autofocus />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="At least 6 characters" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Role" class="form-label fw-semibold">I want to</label>
                    <div class="d-flex gap-3">
                        <div class="form-check flex-fill border rounded p-3" style="cursor:pointer;">
                            <input class="form-check-input" type="radio" asp-for="Role" value="Participant" id="roleParticipant" checked />
                            <label class="form-check-label d-block" for="roleParticipant">
                                <strong>Participate</strong><br>
                                <small class="text-muted">Browse &amp; enter events</small>
                            </label>
                        </div>
                        <div class="form-check flex-fill border rounded p-3" style="cursor:pointer;">
                            <input class="form-check-input" type="radio" asp-for="Role" value="Organiser" id="roleOrganiser" />
                            <label class="form-check-label d-block" for="roleOrganiser">
                                <strong>Organise</strong><br>
                                <small class="text-muted">Create &amp; manage events</small>
                            </label>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn rd-btn-primary w-100 py-2 fw-bold">
                    Create account <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </form>

            <hr class="my-4" />
            <p class="text-center text-muted small mb-0">
                Already have an account?
                <a asp-controller="Auth" asp-action="Login" class="fw-semibold text-danger">Log in</a>
            </p>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
