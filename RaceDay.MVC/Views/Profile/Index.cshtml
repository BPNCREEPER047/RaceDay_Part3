@model UpdateProfileViewModel
@{
    ViewData["Title"] = "Profile";
    var profile = ViewBag.ProfileData as UserDto;
}

<div class="container py-4" style="max-width:580px;">
    <h2 class="mb-4">My Profile</h2>

    <div class="rd-form-card mb-4 p-4">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="rounded-circle d-flex align-items-center justify-content-center"
                 style="width:64px;height:64px;background:var(--rd-charcoal);color:#fff;font-size:1.8rem;font-weight:800;font-family:'Barlow Condensed',sans-serif;">
                @(profile?.FullName.Substring(0, 1).ToUpper() ?? "?")
            </div>
            <div>
                <h4 class="mb-0">@profile?.FullName</h4>
                <span class="rd-role-badge @(profile?.Role == "Organiser" ? "badge-org" : "badge-part")">@profile?.Role</span>
            </div>
        </div>

        <form asp-action="Index" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-semibold">Full name</label>
                <input asp-for="FullName" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold">Email address</label>
                <input asp-for="Email" type="email" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold">New password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Leave blank to keep current" />
                <small class="text-muted">Minimum 6 characters</small>
            </div>

            <div class="mb-4">
                <label asp-for="ProfilePicture" class="form-label fw-semibold">Profile picture</label>
                <input asp-for="ProfilePicture" type="file" class="form-control" accept="image/*" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn rd-btn-primary px-4">
                    <i class="bi bi-check-lg me-1"></i>Save changes
                </button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>

    @if (profile != null)
    {
        <div class="text-muted small">
            <i class="bi bi-clock me-1"></i>Member since @profile.CreatedAt.ToString("MMMM yyyy")
        </div>
    }
</div>
